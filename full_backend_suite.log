            if total_chars + len(text) > _MAX_CHANNEL_CHARS:
                remaining = _MAX_CHANNEL_CHARS - total_chars
                if remaining > 100:
                    collected.append(text[:remaining])
                break
            collected.append(text)
            total_chars += len(text)
    
        if not collected:
